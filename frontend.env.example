# Server-only URL used by Next.js for CMS authentication and public Article reads.
CMS_INTERNAL_API_URL=http://localhost:4000/api

# Browser-facing media origin used by next/image. Keep this aligned with backend MEDIA_PUBLIC_BASE_URL.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:4000/uploads/media

# Canonical public website URL for metadata and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emergency rollback only: serve src/data/articles.ts when the backend is unreachable.
# A valid empty response or 404 from the backend is always respected.
CMS_STATIC_ARTICLE_FALLBACK=true
