# Server-only URL used by Next.js for CMS authentication and public Article reads.
CMS_INTERNAL_API_URL=http://localhost:4000/api

# Browser-facing media origin used by next/image. Keep this aligned with backend MEDIA_PUBLIC_BASE_URL.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:4000/uploads/media

# Canonical public website URL for metadata and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transitional rollback: serve src/data/articles.ts when the backend is unreachable,
# the imported article collection is still empty, or a legacy static slug returns 404.
# Set false immediately after the 8-article import and public URL verification so CMS
# archive/delete behavior becomes authoritative.
CMS_STATIC_ARTICLE_FALLBACK=true

# Optional: restrict /cms, /api/cms and /api/admin to these client IPs (comma-separated
# IPv4, IPv4 CIDR, or IPv6). Others get 404. Leave unset to keep the CMS reachable from anywhere.
# Never include the scanner IP here unless Security asks for it; add every editor/office/VPN egress IP first.
# CMS_ALLOWED_IPS=203.0.113.10,198.51.100.0/24
