NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mednut_cms:mednut_cms_dev@localhost:5432/mednut_cms?schema=public
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=mednut_admin_session
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
# COOKIE_DOMAIN=.example.com

# Media storage. Use `s3` for AWS S3, Cloudflare R2, or another compatible service.
STORAGE_DRIVER=local
MEDIA_LOCAL_STORAGE_PATH=storage/media
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/uploads/media
MEDIA_MAX_FILE_SIZE_BYTES=10485760
MEDIA_MAX_IMAGE_PIXELS=40000000
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=mednut-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Used only by `npm run prisma:seed`; never use these sample values in production.
BOOTSTRAP_ADMIN_NAME=CMS Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Used only by `npm run prisma:import-articles`; must match an active AdminUser.
ARTICLE_IMPORT_AUTHOR_EMAIL=admin@example.com
